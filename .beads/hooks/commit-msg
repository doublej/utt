#!/bin/bash
# Automatically strip AI/vendor attribution from commit messages

TMPFILE=$(mktemp)
cat "$1" > "$TMPFILE"

# Remove lines matching AI attribution patterns (case-insensitive)
grep -viE \
    -e 'Co-Authored-By:.*(Claude|Anthropic|OpenAI|GPT|Copilot|Cursor|noreply@anthropic|noreply@github)' \
    -e '🤖 Generated with' \
    -e 'Generated by (Claude|AI|ChatGPT)' \
    -e '^\[.*Claude.*\]$' \
    "$1" > "$TMPFILE" || true

# Remove trailing empty lines
sed -i '' -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$TMPFILE"

# Check if anything changed
if ! cmp -s "$1" "$TMPFILE"; then
    echo "⚠️  Stripped AI attribution from commit message"
    cat "$TMPFILE" > "$1"
fi

rm -f "$TMPFILE"
exit 0
