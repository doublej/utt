<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
  <!-- Deliberately *not* LSUIElement. It made every launch start as an accessory,
       so double-clicking utt opened its window behind whatever was already there,
       and a bare NSApp.activate() cannot take the focus back — see AppActivation.
       The Dock icon is a runtime decision in AppDelegate instead, which also
       handles the login-item launch this key used to cover. -->
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <!-- Missing NSMicrophoneUsageDescription is a hard crash, not a prompt. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>utt records your voice so it can transcribe it on-device.</string>
  <key>NSInputMonitoringUsageDescription</key>
  <string>utt watches for your push-to-talk hotkey.</string>
  <!-- utt://start, utt://stop, utt://toggle, utt://cancel — see AppDelegate.
       Callers should use `open -g`: bringing utt to the front would make it the
       app the transcript gets pasted into. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>dev.jurrejan.utt</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>CFBundleURLSchemes</key>
      <array><string>utt</string></array>
    </dict>
  </array>
  <!-- Sparkle. The feed is the appcast.xml committed at the root of this repo,
       served raw by GitHub — a fixed URL that costs nothing to host and that
       `just publish` rewrites and pushes on every release. It must stay reachable
       for as long as any copy of utt is installed, so it is deliberately not tied
       to a release tag or an asset id, both of which move.
       SUPublicEDKey is the public half of the EdDSA key in the login keychain;
       lose the private half and no installed copy can ever be updated again. -->
  <key>SUFeedURL</key><string>https://raw.githubusercontent.com/doublej/utt/main/appcast.xml</string>
  <key>SUPublicEDKey</key><string>3f8pu0IeVTScmSSV33gb09yrNFct0DxKX72KrDLkDEY=</string>
  <!-- Checking is on from the first launch, without Sparkle's "may I check for
       updates?" prompt: utt already says on the tin that nothing leaves the
       machine, and an update check that has to be opted into is one nobody turns
       on. Installing still asks — SUAutomaticallyUpdate stays off, so an update
       is never swapped in underneath a recording. -->
  <key>SUEnableAutomaticChecks</key><true/>
  <key>SUScheduledCheckInterval</key><integer>86400</integer>
</dict>
</plist>
